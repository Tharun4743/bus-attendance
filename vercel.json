{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron/open-session",
      "schedule": "20 11 * * *"
    },
    {
      "path": "/api/cron/close-session",
      "schedule": "25 11 * * *"
    },
    {
      "path": "/api/cron/generate-report",
      "schedule": "27 11 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
